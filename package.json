{
  "name": "unitale",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@12.0.1",
  "scripts": {
    "test:booklet-compat": "node --conditions=react-server --import tsx --test tests/booklet-compat/*.test.ts",
    "test:mcp": "node --conditions=react-server --import tsx --test tests/accounts/mcp.test.ts",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/with-environment.mjs node_modules/next/dist/bin/next build && node scripts/build-worker.mjs",
    "worker:build": "node scripts/build-worker.mjs",
    "worker": "node scripts/with-environment.mjs dist/payment-worker.cjs",
    "worker:ai": "node scripts/with-environment.mjs dist/ai-worker.cjs",
    "test:ai-pricing": "node scripts/integration.mjs --ai --ai-pricing",
    "test:ai": "node scripts/integration.mjs --ai",
    "start": "node scripts/start.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:accounts": "node --conditions=react-server --import tsx --test tests/accounts/*.test.ts",
    "check:env": "node scripts/with-environment.mjs --import tsx scripts/check-env.ts",
    "diagnostics": "node scripts/diagnostics-client.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:changed": "node scripts/validate.mjs --changed",
    "audit:quality": "npm audit --json",
    "check:workflows": "node scripts/check-deploy-tools.mjs workflows",
    "check:shell": "node scripts/check-deploy-tools.mjs shell",
    "test:deployment": "node scripts/deploy/test-runner.mjs",
    "test:health": "node scripts/health-integration.mjs",
    "format:check": "prettier --check src scripts tests *.json *.mjs next.config.ts",
    "emulators:auth": "node scripts/auth-emulator.mjs",
    "emulators:mongo": "node scripts/local-mongo.mjs",
    "db:migrate": "node scripts/with-environment.mjs --conditions=react-server --import tsx scripts/db-migrate.ts",
    "db:indexes": "node scripts/with-environment.mjs --conditions=react-server --import tsx scripts/db-indexes.ts",
    "admin:bootstrap": "node scripts/with-environment.mjs --conditions=react-server --import tsx scripts/admin-bootstrap.ts",
    "test:integration": "node scripts/integration.mjs",
    "test:payments": "node scripts/integration.mjs --stripe",
    "icons:generate": "node scripts/generate-icons.mjs",
    "android:generate": "node --import tsx scripts/android-generate.ts",
    "test:limits": "node scripts/test-rate-limits.mjs",
    "prebuild": "node scripts/i18n-assets.mjs",
    "predev": "node scripts/i18n-assets.mjs",
    "check:i18n": "node scripts/i18n-client-sections.mjs --check && node scripts/i18n-assets.mjs --check",
    "project:create": "node --import tsx scripts/create-project.ts",
    "test:initializer": "node --import tsx --test tests/initializer.test.ts",
    "test:initialized-projects": "node --import tsx scripts/test-initialized-projects.ts",
    "samples": "node scripts/samples.mjs list",
    "samples:remove": "node scripts/samples.mjs remove",
    "check:samples": "node scripts/samples.mjs check",
    "template:update": "node scripts/template-update.mjs",
    "check:template": "node scripts/template-version.mjs",
    "check:docs": "node scripts/check-docs.mjs && node scripts/environment-docs.mjs --check && node scripts/booklet-model-diagram.mjs --check",
    "provision:preview": "python scripts/deploy/provision.py",
    "handbook:setup": "node scripts/handbook.mjs setup",
    "handbook:check": "node scripts/handbook.mjs check",
    "handbook:doctor": "node scripts/handbook.mjs doctor",
    "test:handbook": "node --test tests/handbook.test.mjs tests/handbook-integration.test.mjs",
    "handbook:ready": "node scripts/handbook-integration.mjs check",
    "handbook:sync": "node scripts/handbook-integration.mjs sync",
    "handbook:entrypoints": "node scripts/handbook-integration.mjs check-entrypoints",
    "handbook:templates": "node scripts/handbook-integration.mjs templates",
    "deploy:ops": "python scripts/deploy/operations.py",
    "test:billing-compat": "node --conditions=react-server --import tsx --test tests/billing-compat/*.test.ts",
    "test:booklet-foundation": "node --conditions=react-server --import tsx --test tests/accounts/booklet-foundation.test.ts tests/accounts/mcp-foundation.test.ts",
    "test:commerce": "node --conditions=react-server --import tsx --test tests/accounts/commerce-orders-promotions.test.ts tests/accounts/booklet-foundation.test.ts tests/commerce-contracts.test.ts",
    "test:provider-billing": "node --conditions=react-server --import tsx --test tests/accounts/billing-subscriptions.test.ts tests/billing-compat/providers.test.ts",
    "test:commerce-ui": "node --conditions=react-server --import tsx --test tests/accounts/commerce-admin.test.ts tests/play-purchase-client.test.ts tests/credit-config.test.ts",
    "docs:booklet-model": "node scripts/booklet-model-diagram.mjs",
    "test:booklet-repositories": "node --conditions=react-server --import tsx --test tests/accounts/booklet-repositories.test.ts",
    "test:booklet-lifecycle-media": "node --conditions=react-server --import tsx --test tests/accounts/booklet-lifecycle-media.test.ts",
    "test:booklet-application": "node --conditions=react-server --import tsx --test tests/accounts/booklet-application.test.ts",
    "test:booklet-modules": "node --conditions=react-server --import tsx --experimental-test-module-mocks --test tests/booklet-modules/*.test.ts",
    "test:booklet-mcp": "node --conditions=react-server --import tsx --test tests/accounts/booklet-mcp.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@next/env": "16.3.8",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "get-nonce": "1.0.1",
    "lucide-react": "1.51.0",
    "mongodb": "7.7.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "6.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "stripe": "23.0.0",
    "tw-animate-css": "1.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@bubblewrap/core": "1.25.0",
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@modelcontextprotocol/client": "2.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "firebase-tools": "15.32.1",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.9",
    "shadcn": "4.21.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
